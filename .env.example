# Telegram: token from @BotFather, your numeric user id from @userinfobot
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# LLM
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# claude-sonnet-5 | gemini-3.8-flash | claude-opus-5 | claude-haiku-4-5
LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (chat replies; synthesis uses LLM_SYNTHESIS_EFFORT)
LLM_EFFORT=medium
LLM_SYNTHESIS_EFFORT=high
# combined = one call does reply + writes (tools); separate = reply call, then extraction call
HANDLER_MODE=combined

# Storage: local SQLite by default; set a Postgres URL (Supabase) in production
DATABASE_URL=sqlite:///data/coach.db

TIMEZONE=Europe/Warsaw

# Cloud (scripts/deploy.py): the Supabase connection string; deployed as DATABASE_URL on Cloud Run
CLOUD_DATABASE_URL=
# Webhook mode only (production); scripts/deploy.py generates both if empty
WEBHOOK_SECRET=
JOBS_SECRET=
